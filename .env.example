# Copy to .env and fill in. .env is git-ignored.
#
# By default Django reads this file from the project folder. To keep the real
# .env (and everything it points at below) off a cloud-synced folder, set the
# OS environment variable TCWEB_ENV_FILE to its real path instead -- e.g.
# TCWEB_ENV_FILE=D:\TCData\.env -- and put DATABASE_URL / PRIVATE_MEDIA_ROOT /
# MEDIA_ROOT in *that* file, pointing into the same folder. This variable goes
# in the OS environment, never in a .env file itself.

# --- Core ---------------------------------------------------------------
SECRET_KEY=dev-only-change-me-before-deploy
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production behind a Cloudflare Tunnel (no trailing slashes, comma-separated):
# ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# SITE_BASE_URL=https://yourdomain.com      # links in emails
# CONSOLE_HOST=manage.yourdomain.com        # private console host: dashboard at its root (no /manage/ prefix);
#                                          # other hosts stop serving /manage/ and /admin/. Add it to ALLOWED_HOSTS
#                                          # and CSRF_TRUSTED_ORIGINS too. Empty = single-host layout (console at /manage/).
# SECURE_SSL_REDIRECT=False                 # True = Django also forces HTTPS (Cloudflare 'Always Use HTTPS' already does at the edge)

# --- Database -----------------------------------------------------------
# Unset -> local SQLite in the project folder (Milestone 0-5 dev default).
# A real deployment should point this outside the project folder, e.g.
# DATABASE_URL=sqlite:///D:/TCData/db.sqlite3
# Production (Milestone 6): a Postgres URL, e.g.
# DATABASE_URL=postgres://tshirtshop:password@127.0.0.1:5432/tshirtshop

# --- Media --------------------------------------------------------------
# Both unset -> served from the project folder. Point them elsewhere (same
# folder as DATABASE_URL above) to keep uploads off a cloud-synced drive too.
# MEDIA_ROOT=D:/TCData/media                    # public product images
# PRIVATE_MEDIA_ROOT=D:/TCData/private_media    # print-ready originals (console-only)

# --- Email -------------------------------------------------------------
# Unset -> console backend (emails print to the terminal).
# EMAIL_URL=smtp://user:pass@smtp.provider.com:587?tls=True   # Milestone 2
DEFAULT_FROM_EMAIL=The T-Shirt Shop <shop@example.com>

# --- Stripe (Milestone 2) --------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Printful (Milestone 3) -----------------------------------------
PRINTFUL_API_KEY=
# Seconds a signed print-file link handed to Printful stays valid (default 1800).
# PRINTFUL_ARTWORK_LINK_MAX_AGE=1800

# --- Two-factor sign-in (console + Django admin) ---------------------------
# Staff must pass an authenticator-app code. Enroll with:
#   python manage.py otp_setup <username>
# STAFF_2FA_REQUIRED=True        # set False only for throwaway local dev
# STAFF_2FA_MAX_AGE=43200        # seconds before re-verifying (default 12h)
