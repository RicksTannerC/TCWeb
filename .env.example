# Copy to .env and fill in. .env is git-ignored.

# --- Core ---------------------------------------------------------------
SECRET_KEY=dev-only-change-me-before-deploy
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production behind a Cloudflare Tunnel (no trailing slashes, comma-separated):
# ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# SITE_BASE_URL=https://yourdomain.com      # links in emails
# SECURE_SSL_REDIRECT=False                 # True = Django also forces HTTPS (Cloudflare 'Always Use HTTPS' already does at the edge)

# --- Database -----------------------------------------------------------
# Unset -> local SQLite (Milestone 0-5 dev default).
# Production (Milestone 6): a Postgres URL, e.g.
# DATABASE_URL=postgres://tshirtshop:password@127.0.0.1:5432/tshirtshop

# --- Email -------------------------------------------------------------
# Unset -> console backend (emails print to the terminal).
# EMAIL_URL=smtp://user:pass@smtp.provider.com:587?tls=True   # Milestone 2
DEFAULT_FROM_EMAIL=The T-Shirt Shop <shop@example.com>

# --- Stripe (Milestone 2) --------------------------------------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Printful (Milestone 3) -----------------------------------------
PRINTFUL_API_KEY=

# --- Two-factor sign-in (console + Django admin) ---------------------------
# Staff must pass an authenticator-app code. Enroll with:
#   python manage.py otp_setup <username>
# STAFF_2FA_REQUIRED=True        # set False only for throwaway local dev
# STAFF_2FA_MAX_AGE=43200        # seconds before re-verifying (default 12h)
